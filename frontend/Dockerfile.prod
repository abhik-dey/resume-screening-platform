# Production frontend image: multi-stage, so the shipped image contains
# nginx and static files only — no node, no npm, no source.

# ---- Build stage ----
FROM node:20-slim AS builder

WORKDIR /app

# npm ci (not install) so the build uses exactly the locked versions.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# The API base URL is baked in at build time — Vite inlines env vars into
# the bundle, so it cannot be changed at container runtime. Deploying to a
# different host means rebuilding with a different value. Called out
# because it's a genuine constraint of client-side builds, not an oversight.
ARG VITE_API_BASE_URL=/api-proxy
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ---- Runtime stage ----
FROM nginx:1.27-alpine

# nginx's default config runs the master as root to bind port 80. Using an
# unprivileged port and a non-root user avoids that entirely.
RUN addgroup -g 1001 -S appuser && adduser -u 1001 -S appuser -G appuser

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# nginx needs write access to these paths for temp files and its pid.
RUN chown -R appuser:appuser /usr/share/nginx/html /var/cache/nginx \
    && touch /var/run/nginx.pid && chown appuser:appuser /var/run/nginx.pid

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -q --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
