APP_NAME="AI Resume Screening Platform"
ENVIRONMENT=development
DEBUG=true

POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_pass
POSTGRES_DB=resume_screening
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

CORS_ORIGINS=["http://localhost:5173"]

# Generate a real value with: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
