# Production environment template.
#
#   cp backend/.env.prod.example backend/.env.prod
#
# Every value below marked REQUIRED must be changed. The production compose
# file fails to start rather than falling back to a default for the
# credentials — a silent default in production is worse than a startup error.

# --- Database (REQUIRED) ---
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
POSTGRES_DB=resume_screening

# --- Auth (REQUIRED) ---
# Generate: openssl rand -hex 32
# Reusing the development secret means every token ever issued in dev is
# valid in production.
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# The frontend is served from the same origin behind nginx, so no
# cross-origin entry is needed. Add one only if a separate origin exists,
# and never use "*" — it defeats the purpose.
CORS_ORIGINS=[]

# --- LLM (REQUIRED) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Vector search ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333

# --- Storage ---
RESUME_STORAGE_DIR=/app/storage/resumes
MAX_RESUME_UPLOAD_SIZE_MB=10

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
TRACING_ENABLED=false
OTLP_ENDPOINT=

# --- Security ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_EXPENSIVE=20
RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_HEADERS_ENABLED=true
INJECTION_DETECTION_ENABLED=true

# --- Tools ---
GITHUB_TOOL_ENABLED=false
GITHUB_TOKEN=
TOOL_FILESYSTEM_ROOT=/app/storage

# --- Runtime ---
# This app is I/O-bound on LLM calls, not CPU-bound, so the usual
# (2 x cores + 1) heuristic doesn't apply. The right number depends more on
# provider rate limits than on hardware.
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=300

# --- Monitoring (REQUIRED) ---
GRAFANA_PASSWORD=CHANGE_ME
GRAFANA_PORT=3000
HTTP_PORT=80
